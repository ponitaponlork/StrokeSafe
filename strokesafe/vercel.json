{
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/((?!api/|assets/|brand/|fonts/|sw.js|precache-manifest.json|manifest.webmanifest).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/precache-manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}