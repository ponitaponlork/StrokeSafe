# ---------------------------------------------------------------------------
# Server-side only (Vercel → Project → Settings → Environment Variables).
# NEVER prefix these with VITE_ (anything with VITE_ is bundled into the browser).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: model for the assistant and dashboard summary
ASSISTANT_MODEL=claude-haiku-5-5
# Preferred provider. If set, it is used instead of Anthropic.
GEMINI_API_KEY=
# Optional: primary Gemini model (backups are built in)
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Browser (public) keys. Copy this file to .env.local for local development.
# ---------------------------------------------------------------------------
# Google Maps JavaScript API key for Find Care. This key IS visible in the browser by design,
# so restrict it in Google Cloud: Application restriction = Websites (HTTP referrers),
# API restriction = Maps JavaScript API only. See README → "Google Maps".
# Leave empty to use the built-in OpenStreetMap (Leaflet) map instead.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud → Map Management. Enables Advanced Markers.
VITE_GOOGLE_MAPS_MAP_ID=
